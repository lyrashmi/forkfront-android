<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:background="@color/eink_white"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent">

	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical|right"
		android:padding="8dp"
		android:background="@color/eink_white">

		<TextView
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="Text"
			style="@style/DialogTitle"
			android:paddingLeft="8dp" />

		<Button
			android:id="@+id/btn_close"
			style="@style/ButtonText"
			android:layout_width="wrap_content"
			android:minWidth="90dp"
			android:layout_height="wrap_content"
			android:text="Close" />
	</LinearLayout>

	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:background="@color/eink_black" />

	<ScrollView
		android:id="@+id/scrollview"
		android:fillViewport="true"
		android:clickable="true"
		android:background="@color/eink_white"
		android:layout_weight="1"
		android:layout_width="fill_parent"
		android:layout_height="0dip">

		<com.tbd.forkfront.NH_TextView
			android:id="@+id/text_view"
			style="@style/WindowText"
			android:background="@color/eink_white"
			android:maxLength="999999"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"/>
	</ScrollView>

	<ImageView
		android:id="@+id/pager_divider"
		android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:background="@color/eink_black"
		android:visibility="gone" />

	<LinearLayout
		android:id="@+id/pager_bar"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center"
		android:paddingTop="6dp"
		android:paddingBottom="6dp"
		android:visibility="gone">

		<Button
			android:id="@+id/btn_prev_page"
			style="@style/ButtonText"
			android:layout_width="wrap_content"
			android:minWidth="90dp"
			android:layout_height="wrap_content"
			android:text="&#x25c4; Prev" />

		<TextView
			android:id="@+id/txt_page_num"
			style="@style/DialogText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:text="Page 1/1" />

		<Button
			android:id="@+id/btn_next_page"
			style="@style/ButtonText"
			android:layout_width="wrap_content"
			android:minWidth="90dp"
			android:layout_height="wrap_content"
			android:text="Next &#x25ba;" />
	</LinearLayout>

</LinearLayout>
