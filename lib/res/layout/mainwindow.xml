<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_frame"
    android:background="#ffffffff"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:baselineAligned="false"
    android:orientation="vertical" >

    <FrameLayout
        android:id="@+id/dlg_frame"
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1" >

        <FrameLayout
            android:id="@+id/map_frame"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:descendantFocusability="blocksDescendants" >

            <com.tbd.forkfront.CmdPanelLayout
                android:id="@+id/cmdPanelLayout1"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" >

                <LinearLayout
                    android:id="@+id/top_bar_container"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|fill_horizontal"
                    android:orientation="vertical"
                    android:background="@drawable/eink_topbar_background" >

                    <com.tbd.forkfront.AutoFitTextView
                        android:id="@+id/nh_stat0"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp" />

                    <com.tbd.forkfront.AutoFitTextView
                        android:id="@+id/nh_stat1"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="1dp"
                        android:background="@color/eink_divider" />

                    <com.tbd.forkfront.NH_TextView
                        android:id="@+id/nh_message"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp" />

                    <com.tbd.forkfront.NH_TextView
                        android:id="@+id/more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--More--"
                        android:background="@drawable/btn_eink_selector"
                        android:textColor="@color/btn_eink_text_selector"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:clickable="true"
                        android:visibility="gone"
                        android:textSize="15sp" />
                </LinearLayout>

                <com.tbd.forkfront.NH_TextView
                    android:id="@+id/nh_blockmsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
					android:padding="8dip"
					android:layout_marginBottom="10dip"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:text="Tap to continue"
                    android:textColor="@color/eink_black"
                    android:background="@drawable/eink_dialog_box"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/dpad"
                    layout="@layout/dpad_ovl" />

				
                <LinearLayout
                     android:id="@+id/viewArea"
                     android:layout_width="fill_parent"
                     android:layout_height="fill_parent"
                     android:orientation="horizontal"/>
                
            </com.tbd.forkfront.CmdPanelLayout>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/kbd_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom" />

</LinearLayout>
