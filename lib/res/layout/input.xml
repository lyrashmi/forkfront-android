<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:visibility="gone"
	android:background="@color/eink_white">

	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical|right"
		android:padding="4dp"
		android:background="@color/eink_white">

		<Button
			android:id="@+id/btn_close_kbd"
			style="@style/ButtonText"
			android:layout_width="wrap_content"
			android:minWidth="90dp"
			android:layout_height="wrap_content"
			android:text="Close &#x25bc;" />
	</LinearLayout>

	<ImageView
		android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:background="@color/eink_black" />

	<android.inputmethodservice.KeyboardView
		android:id="@+id/keyboard"
		android:background="@color/eink_white"
		android:keyBackground="@drawable/btn_eink_selector"
		android:keyTextColor="@color/eink_black"
		android:shadowRadius="0"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"/>

</LinearLayout>
