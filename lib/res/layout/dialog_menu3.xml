<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/menu_layout"
	android:background="@color/eink_scrim"
	android:clickable="true"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent">
	<LinearLayout
		style="@style/NH_Dialog"
		android:padding="18dip"
		android:clickable="true"
		android:orientation="vertical"
		android:layout_centerInParent="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

		<com.tbd.forkfront.NH_TextView
			android:id="@+id/title"
			style="@style/DialogTitle"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:padding="12dip"/>

		<ListView
			android:id="@+id/menu_list"
			android:cacheColorHint="#00000000"
			android:listSelector="@drawable/menu_row_selector"
			android:divider="@color/eink_divider"
			android:dividerHeight="1dip"
			android:layout_weight="1"
			android:layout_margin="6dip"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"/>

		<ImageView
			android:id="@+id/pager_divider"
			android:layout_width="fill_parent"
			android:layout_height="1dp"
			android:background="@color/eink_black"
			android:visibility="gone" />

		<LinearLayout
			android:id="@+id/pager_bar"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center"
			android:paddingTop="6dip"
			android:paddingBottom="6dip"
			android:visibility="gone">

			<Button
				android:id="@+id/btn_prev_page"
				style="@style/ButtonText"
				android:layout_width="wrap_content"
				android:minWidth="90dp"
				android:layout_height="wrap_content"
				android:text="&#x25c4; Prev" />

			<TextView
				android:id="@+id/txt_page_num"
				style="@style/DialogText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:paddingLeft="16dip"
				android:paddingRight="16dip"
				android:text="Page 1/1" />

			<Button
				android:id="@+id/btn_next_page"
				style="@style/ButtonText"
				android:layout_width="wrap_content"
				android:minWidth="90dp"
				android:layout_height="wrap_content"
				android:text="Next &#x25ba;" />
		</LinearLayout>

		<LinearLayout
			android:orientation="horizontal"
			android:gravity="right|center_vertical"
			android:paddingTop="6dip"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content">
			<Button
				android:id="@+id/btn_all"
				style="@style/ButtonText"
				android:text="Select all"
				android:layout_width="wrap_content"
				android:minWidth="90dp"
				android:layout_marginRight="8dp"
				android:layout_height="wrap_content"/>
			<Button
				android:id="@+id/btn_ok"
				style="@style/ButtonText"
				android:text="Ok"
				android:layout_width="wrap_content"
				android:minWidth="90dp"
				android:layout_marginRight="8dp"
				android:layout_height="wrap_content"/>
			<Button
				android:id="@+id/btn_cancel"
				style="@style/ButtonText"
				android:text="Cancel"
				android:layout_width="wrap_content"
				android:minWidth="90dp"
				android:layout_height="wrap_content"/>
		</LinearLayout>

	</LinearLayout>
</RelativeLayout>
